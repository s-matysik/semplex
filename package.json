{
  "name": "semplex-app",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "license": "MIT",
  "description": "SEMplex - survey analysis in the browser (Polish and English interface): data screening, reliability, EFA, CFA, SEM, mediation, approach comparison and APA report.",
  "scripts": {
    "build": "node tools/build.mjs",
    "test:ui": "node tools/ui-test.mjs",
    "test:wasm": "node tools/engine-wasm-test.mjs",
    "test:engine": "python -m pytest tests -q",
    "dev": "vite",
    "sample": "python tools/make_sample.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semplex-ui": "file:vendor/semplex-ui"
  },
  "devDependencies": {
    "esbuild-wasm": "0.21.5",
    "happy-dom": "15.11.7",
    "vite": "^5.4.11",
    "@vitejs/plugin-react": "^4.3.4"
  },
  "engines": {
    "node": ">=18"
  }
}
